DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
JWT_SECRET=your_jwt_secret_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
ADMIN_ID=admin_id
ADMIN_PASSWORD=admin_password
# Restrict recruitment sign-in to one or more email domains.
# Leave EMPTY to allow any email address. Set it to switch the gate on, e.g.
#   ALLOWED_EMAIL_DOMAINS=vitstudent.ac.in
# A leading @ is fine, and several domains can be comma separated:
#   ALLOWED_EMAIL_DOMAINS=@vitstudent.ac.in,vit.ac.in
# Set BOTH: the server enforces the first, the browser reads the second.
ALLOWED_EMAIL_DOMAINS=
VITE_ALLOWED_EMAIL_DOMAINS=

# ── Recruitment module ────────────────────────────────────────────────────────
# Frontend (safe to expose in client bundle — anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only — NEVER put in a VITE_ variable
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
